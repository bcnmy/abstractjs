{
  "name": "@biconomy/abstractjs",
  "version": "1.1.1",
  "description": "Biconomy SDK for building decentralized applications with ERC4337 Account Abstraction and Smart Accounts",
  "main": "./dist/_cjs/index.js",
  "module": "./dist/_esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/_esm/index.js",
      "require": "./dist/_cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "size": "size-limit",
    "fund:nexus": "tsx src/test/fundNexus.ts"
  },
  "dependencies": {
    "@biconomy/ecosystem": "^1.0.0",
    "@rhinestone/module-sdk": "^1.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^20.19.12",
    "@vitest/coverage-v8": "^1.0.0",
    "biome": "^1.5.0",
    "dotenv": "^16.4.5",
    "foundry": "^0.2.0",
    "prool": "^0.0.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "biconomy",
    "account-abstraction",
    "erc4337",
    "smart-accounts",
    "blockchain",
    "ethereum",
    "dapp",
    "sdk"
  ],
  "author": "Biconomy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcnmy/abstractjs.git"
  },
  "bugs": {
    "url": "https://github.com/bcnmy/abstractjs/issues"
  },
  "homepage": "https://biconomy.io"
}
